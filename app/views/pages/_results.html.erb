<dl id="results" class="counter-results">
  <div>
    <dt>Words</dt>
    <dd><%= number_with_delimiter stats.word_count %></dd>
  </div>
  <div>
    <dt>Characters</dt>
    <dd><%= number_with_delimiter stats.character_count %></dd>
  </div>
  <div>
    <dt>Sentences</dt>
    <dd><%= number_with_delimiter stats.sentence_count %></dd>
  </div>
</dl>
